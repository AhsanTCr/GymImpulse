rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global safety net: deny everything by default
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() && (
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        (request.auth.token.email == 'hereyourmax@gmail.com' && request.auth.token.email_verified == true)
      );
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidDateKey(dateKey) {
      return dateKey is string && dateKey.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$');
    }

    function isValidTimestamp(ts) {
      return ts is timestamp && ts <= request.time;
    }

    // --- Validation Helpers ---

    function isValidUserProfile(data) {
      return data.userId is string && data.userId.size() <= 128 &&
             data.memberCode is string && data.memberCode.size() >= 4 && data.memberCode.size() <= 32 &&
             data.fullName is string && data.fullName.size() >= 2 && data.fullName.size() <= 80 &&
             data.email is string && data.email.size() <= 120 &&
             (!('phone' in data) || data.phone == null || (data.phone is string && data.phone.size() <= 32)) &&
             (!('avatarData' in data) || data.avatarData == null || (data.avatarData is string && data.avatarData.size() <= 120000)) &&
             data.role in ['MEMBER', 'ADMIN'] &&
             data.joinedDate is string && data.joinedDate.size() <= 40 &&
             (!('fitnessGoal' in data) || data.fitnessGoal == null || (data.fitnessGoal is string && data.fitnessGoal.size() <= 140)) &&
             data.referralCode is string && data.referralCode.size() >= 4 && data.referralCode.size() <= 24 &&
             (!('referredByCode' in data) || data.referredByCode == null || (data.referredByCode is string && data.referredByCode.size() <= 24));
    }

    function isValidMembershipRecord(data) {
      return data.userId is string && data.userId.size() <= 128 &&
             data.planName is string && data.planName.size() >= 2 && data.planName.size() <= 80 &&
             data.monthlyFeeUsd is number && data.monthlyFeeUsd >= 0 && data.monthlyFeeUsd <= 5000 &&
             data.membershipStartDate is string && data.membershipStartDate.size() <= 40 &&
             data.cycleStartDate is string && data.cycleStartDate.size() <= 40 &&
             data.cycleEndDate is string && data.cycleEndDate.size() <= 40 &&
             data.nextRenewalDate is string && data.nextRenewalDate.size() <= 40 &&
             data.status in ['ACTIVE', 'EXPIRING_SOON', 'EXPIRED', 'PAYMENT_OVERDUE'] &&
             data.autoRenewEnabled is bool;
    }

    function isValidPaymentRequest(data) {
      return data.userId is string && data.userId.size() <= 128 &&
             data.memberName is string && data.memberName.size() >= 2 && data.memberName.size() <= 80 &&
             data.memberCode is string && data.memberCode.size() <= 32 &&
             data.amountFormatted is string && data.amountFormatted.size() <= 32 &&
             data.paymentMethod is string && data.paymentMethod.size() <= 40 &&
             (!('referenceNote' in data) || data.referenceNote == null || (data.referenceNote is string && data.referenceNote.size() <= 160)) &&
             data.paymentDateLabel is string && data.paymentDateLabel.size() <= 40 &&
             data.status in ['PENDING_VERIFICATION', 'VERIFIED', 'REJECTED'] &&
             data.isVerified is bool;
    }

    function isValidPaymentRecord(data) {
      return data.userId is string && data.userId.size() <= 128 &&
             data.paymentDate is string && data.paymentDate.size() <= 40 &&
             data.cycleCovered is string && data.cycleCovered.size() <= 60 &&
             data.amountFormatted is string && data.amountFormatted.size() <= 32 &&
             data.method is string && data.method.size() <= 40 &&
             data.referenceNumber is string && data.referenceNumber.size() <= 40 &&
             data.isVerified is bool;
    }

    function isValidAttendanceRecord(data) {
      return data.userId is string && data.userId.size() <= 128 &&
             isValidDateKey(data.dateKey) &&
             data.dateLabel is string && data.dateLabel.size() <= 40 &&
             data.checkInTime is string && data.checkInTime.size() <= 32 &&
             data.zoneLabel is string && data.zoneLabel.size() <= 100 &&
             data.gymCode is string && data.gymCode == 'APEXPULSE-MAIN-ENTRANCE-QR-001' &&
             data.verificationToken is string && data.verificationToken.size() >= 6 && data.verificationToken.size() <= 120 &&
             data.verifiedViaCommonQr == true;
    }

    function isValidDailyFoodLog(data) {
      return data.userId is string && data.userId.size() <= 128 &&
             isValidDateKey(data.dateKey) &&
             data.dateLabel is string && data.dateLabel.size() <= 40 &&
             data.takenFoodIds is list && data.takenFoodIds.size() <= 40 &&
             (data.takenFoodIds.size() == 0 || data.takenFoodIds[0] is string) &&
             (!('servingsByFood' in data) || data.servingsByFood is map) &&
             data.totalProteinGrams is int && data.totalProteinGrams >= 0 && data.totalProteinGrams <= 1000 &&
             data.totalCalories is int && data.totalCalories >= 0 && data.totalCalories <= 12000 &&
             data.foodsCount is int && data.foodsCount >= 0 && data.foodsCount <= 40;
    }

    function isValidMemberSettings(data) {
      return data.userId is string && data.userId.size() <= 128 &&
             data.attendanceReminders is bool &&
             data.nutritionGoalReminders is bool &&
             data.membershipExpiryAlerts is bool &&
             data.gymAnnouncements is bool &&
             data.leaderboardUpdates is bool &&
             (!('morningFuelEnabled' in data) || data.morningFuelEnabled is bool) &&
             (!('postWorkoutProteinEnabled' in data) || data.postWorkoutProteinEnabled is bool) &&
             (!('eveningCheckInEnabled' in data) || data.eveningCheckInEnabled is bool);
    }

    function isValidLeaderboardStat(data) {
      return data.userId is string && data.userId.size() <= 128 &&
             data.memberName is string && data.memberName.size() >= 2 && data.memberName.size() <= 80 &&
             (!('avatarData' in data) || data.avatarData == null || (data.avatarData is string && data.avatarData.size() <= 120000)) &&
             data.currentStreakDays is int && data.currentStreakDays >= 0 && data.currentStreakDays <= 3660 &&
             data.longestStreakDays is int && data.longestStreakDays >= 0 && data.longestStreakDays <= 3660 &&
             data.monthlyVisits is int && data.monthlyVisits >= 0 && data.monthlyVisits <= 100 &&
             data.weeklyTargetMetWeeks is int && data.weeklyTargetMetWeeks >= 0 && data.weeklyTargetMetWeeks <= 520 &&
             data.healthyHabitsScore is int && data.healthyHabitsScore >= 0 && data.healthyHabitsScore <= 100 &&
             data.verifiedReferralsCount is int && data.verifiedReferralsCount >= 0 && data.verifiedReferralsCount <= 1000 &&
             data.isMonthlyWinner is bool &&
             data.monthKey is string && data.monthKey.size() <= 16;
    }

    function isValidReferralRecord(data) {
      return (!('referrerUserId' in data) || data.referrerUserId == null || (data.referrerUserId is string && data.referrerUserId.size() <= 128)) &&
             data.referrerCode is string && data.referrerCode.size() >= 4 && data.referrerCode.size() <= 24 &&
             data.referredUserId is string && data.referredUserId.size() <= 128 &&
             data.referredName is string && data.referredName.size() >= 2 && data.referredName.size() <= 80 &&
             data.status in ['PENDING_VERIFICATION', 'VERIFIED', 'REJECTED'] &&
             data.isVerified is bool;
    }

    // --- Admin Registry ---
    match /admins/{adminUid} {
      allow get: if isOwner(adminUid) || isAdmin();
      allow list, write: if false;
    }

    // --- Private Member Account & Subcollections ---
    match /users/{userId} {
      allow get: if isValidId(userId) && (isOwner(userId) || isAdmin());
      allow list: if isAdmin();

      // Prevent privilege escalation: client create forces role == 'MEMBER'
      allow create: if isValidId(userId) && isOwner(userId) &&
                       incoming().userId == request.auth.uid &&
                       incoming().role == 'MEMBER' &&
                       incoming().keys().hasAll(['userId', 'memberCode', 'fullName', 'email', 'role', 'joinedDate', 'referralCode', 'createdAt', 'updatedAt']) &&
                       incoming().keys().hasOnly(['userId', 'memberCode', 'fullName', 'phone', 'email', 'avatarData', 'role', 'joinedDate', 'fitnessGoal', 'referralCode', 'referredByCode', 'createdAt', 'updatedAt']) &&
                       isValidTimestamp(incoming().createdAt) &&
                       isValidTimestamp(incoming().updatedAt) &&
                       isValidUserProfile(incoming());

      allow update: if isValidId(userId) && isValidUserProfile(incoming()) && (
                       isAdmin() ||
                       (isOwner(userId) &&
                        incoming().userId == existing().userId &&
                        incoming().role == existing().role &&
                        incoming().memberCode == existing().memberCode &&
                        incoming().referralCode == existing().referralCode &&
                        incoming().createdAt == existing().createdAt &&
                        isValidTimestamp(incoming().updatedAt) &&
                        incoming().diff(existing()).affectedKeys().hasOnly(['fullName', 'phone', 'avatarData', 'fitnessGoal', 'updatedAt']))
                    );

      allow delete: if isAdmin();

      // Membership records: member can read & create initial unverified/expired starter record; ONLY admin can activate/modify cycles
      match /memberships/{membershipId} {
        allow get: if isValidId(userId) && isValidId(membershipId) && (isOwner(userId) || isAdmin());
        allow list: if isValidId(userId) && (isOwner(userId) || isAdmin());

        allow create: if isValidId(userId) && isValidId(membershipId) && (
                         isAdmin() ||
                         (isOwner(userId) &&
                          incoming().userId == request.auth.uid &&
                          incoming().status == 'EXPIRED' &&
                          incoming().keys().hasAll(['userId', 'planName', 'monthlyFeeUsd', 'membershipStartDate', 'cycleStartDate', 'cycleEndDate', 'nextRenewalDate', 'status', 'autoRenewEnabled', 'updatedAt']) &&
                          incoming().keys().hasOnly(['userId', 'planName', 'monthlyFeeUsd', 'membershipStartDate', 'cycleStartDate', 'cycleEndDate', 'nextRenewalDate', 'status', 'autoRenewEnabled', 'updatedAt']) &&
                          isValidTimestamp(incoming().updatedAt) &&
                          isValidMembershipRecord(incoming()))
                      );

        allow update: if isValidId(userId) && isValidId(membershipId) && isAdmin() && isValidMembershipRecord(incoming());
        allow delete: if false;
      }

      // Payment requests: members submit PENDING_VERIFICATION requests; ONLY admin can verify/approve
      match /payment_requests/{requestId} {
        allow get: if isValidId(userId) && isValidId(requestId) && (isOwner(userId) || isAdmin());
        allow list: if isValidId(userId) && (isOwner(userId) || isAdmin());

        allow create: if isValidId(userId) && isValidId(requestId) && isOwner(userId) &&
                         incoming().userId == request.auth.uid &&
                         incoming().status == 'PENDING_VERIFICATION' &&
                         incoming().isVerified == false &&
                         incoming().keys().hasAll(['userId', 'memberName', 'memberCode', 'amountFormatted', 'paymentMethod', 'paymentDateLabel', 'status', 'isVerified', 'createdAt']) &&
                         incoming().keys().hasOnly(['userId', 'memberName', 'memberCode', 'amountFormatted', 'paymentMethod', 'referenceNote', 'paymentDateLabel', 'status', 'isVerified', 'createdAt']) &&
                         isValidTimestamp(incoming().createdAt) &&
                         isValidPaymentRequest(incoming());

        allow update: if isValidId(userId) && isValidId(requestId) && isAdmin() && isValidPaymentRequest(incoming());
        allow delete: if false;
      }

      // Verified payment records: read-only for member, write restricted to admin
      match /payments/{paymentId} {
        allow get: if isValidId(userId) && isValidId(paymentId) && (isOwner(userId) || isAdmin());
        allow list: if isValidId(userId) && (isOwner(userId) || isAdmin());
        allow create, update: if isValidId(userId) && isValidId(paymentId) && isAdmin() && isValidPaymentRecord(incoming());
        allow delete: if false;
      }

      // Immutable daily entrance QR attendance logs keyed by YYYY-MM-DD (prevents duplicates)
      match /attendance/{dateKey} {
        allow get: if isValidId(userId) && isValidDateKey(dateKey) && (isOwner(userId) || isAdmin());
        allow list: if isValidId(userId) && (isOwner(userId) || isAdmin());

        allow create: if isValidId(userId) && isValidDateKey(dateKey) && isOwner(userId) &&
                         incoming().userId == request.auth.uid &&
                         incoming().dateKey == dateKey &&
                         incoming().keys().hasAll(['userId', 'dateKey', 'dateLabel', 'checkInTime', 'zoneLabel', 'gymCode', 'verificationToken', 'verifiedViaCommonQr', 'createdAt']) &&
                         incoming().keys().hasOnly(['userId', 'dateKey', 'dateLabel', 'checkInTime', 'zoneLabel', 'gymCode', 'verificationToken', 'verifiedViaCommonQr', 'createdAt']) &&
                         isValidTimestamp(incoming().createdAt) &&
                         isValidAttendanceRecord(incoming());

        allow update, delete: if false;
      }

      // Daily food & nutrition logs keyed by YYYY-MM-DD
      match /food_logs/{dateKey} {
        allow get: if isValidId(userId) && isValidDateKey(dateKey) && (isOwner(userId) || isAdmin());
        allow list: if isValidId(userId) && (isOwner(userId) || isAdmin());

        allow create: if isValidId(userId) && isValidDateKey(dateKey) && isOwner(userId) &&
                         incoming().userId == request.auth.uid &&
                         incoming().dateKey == dateKey &&
                         incoming().keys().hasAll(['userId', 'dateKey', 'dateLabel', 'takenFoodIds', 'totalProteinGrams', 'totalCalories', 'foodsCount', 'updatedAt']) &&
                         incoming().keys().hasOnly(['userId', 'dateKey', 'dateLabel', 'takenFoodIds', 'servingsByFood', 'totalProteinGrams', 'totalCalories', 'foodsCount', 'updatedAt']) &&
                         isValidTimestamp(incoming().updatedAt) &&
                         isValidDailyFoodLog(incoming());

        allow update: if isValidId(userId) && isValidDateKey(dateKey) && isOwner(userId) &&
                         incoming().userId == existing().userId &&
                         incoming().dateKey == existing().dateKey &&
                         isValidTimestamp(incoming().updatedAt) &&
                         isValidDailyFoodLog(incoming()) &&
                         incoming().diff(existing()).affectedKeys().hasOnly(['takenFoodIds', 'servingsByFood', 'totalProteinGrams', 'totalCalories', 'foodsCount', 'updatedAt']);

        allow delete: if false;
      }

      // Notification & reminder settings
      match /settings/{settingId} {
        allow get: if isValidId(userId) && isValidId(settingId) && isOwner(userId);
        allow list: if isValidId(userId) && isOwner(userId);

        allow create: if isValidId(userId) && isValidId(settingId) && isOwner(userId) &&
                         incoming().userId == request.auth.uid &&
                         isValidTimestamp(incoming().updatedAt) &&
                         isValidMemberSettings(incoming());

        allow update: if isValidId(userId) && isValidId(settingId) && isOwner(userId) &&
                         incoming().userId == existing().userId &&
                         isValidTimestamp(incoming().updatedAt) &&
                         isValidMemberSettings(incoming());

        allow delete: if false;
      }
    }

    // --- Public Leaderboard Stats (NO PII) ---
    match /leaderboard_stats/{userId} {
      allow get: if isValidId(userId) && isSignedIn();
      allow list: if isSignedIn();

      // Client can initialize or sync own non-privileged workout/habit stats;
      // verifiedReferralsCount and isMonthlyWinner are strictly locked to admin verification!
      allow create: if isValidId(userId) && isOwner(userId) &&
                       incoming().userId == request.auth.uid &&
                       incoming().verifiedReferralsCount == 0 &&
                       incoming().isMonthlyWinner == false &&
                       incoming().keys().hasAll(['userId', 'memberName', 'currentStreakDays', 'longestStreakDays', 'monthlyVisits', 'weeklyTargetMetWeeks', 'healthyHabitsScore', 'verifiedReferralsCount', 'isMonthlyWinner', 'monthKey', 'updatedAt']) &&
                       incoming().keys().hasOnly(['userId', 'memberName', 'avatarData', 'currentStreakDays', 'longestStreakDays', 'monthlyVisits', 'weeklyTargetMetWeeks', 'healthyHabitsScore', 'verifiedReferralsCount', 'isMonthlyWinner', 'monthKey', 'updatedAt']) &&
                       isValidTimestamp(incoming().updatedAt) &&
                       isValidLeaderboardStat(incoming());

      allow update: if isValidId(userId) && isValidLeaderboardStat(incoming()) && (
                       isAdmin() ||
                       (isOwner(userId) &&
                        incoming().userId == existing().userId &&
                        incoming().verifiedReferralsCount == existing().verifiedReferralsCount &&
                        incoming().isMonthlyWinner == existing().isMonthlyWinner &&
                        // Prevent arbitrary single-write inflation (at most +1 per verified sync)
                        incoming().currentStreakDays <= existing().currentStreakDays + 1 &&
                        incoming().monthlyVisits <= existing().monthlyVisits + 1 &&
                        isValidTimestamp(incoming().updatedAt) &&
                        incoming().diff(existing()).affectedKeys().hasOnly(['memberName', 'avatarData', 'currentStreakDays', 'longestStreakDays', 'monthlyVisits', 'weeklyTargetMetWeeks', 'healthyHabitsScore', 'monthKey', 'updatedAt']))
                    );

      allow delete: if false;
    }

    // --- Historical Monthly Winners ---
    match /leaderboard_history/{historyId} {
      allow get: if isValidId(historyId) && isSignedIn();
      allow list: if isSignedIn();
      allow create, update, delete: if isAdmin();
    }

    // --- Gym Announcements ---
    match /announcements/{announcementId} {
      allow get: if isValidId(announcementId) && isSignedIn();
      allow list: if isSignedIn();
      allow create, update, delete: if isAdmin();
    }

    // --- Gym Common Entrance QR Config ---
    match /gym_config/{configId} {
      allow get: if isValidId(configId) && isSignedIn();
      allow list: if isSignedIn();
      allow create, update, delete: if isAdmin();
    }

    // --- App Version / Update Metadata ---
    match /app_config/{docId} {
      allow get: if isValidId(docId) && isSignedIn();
      allow list: if false;
      allow create, update, delete: if isAdmin();
    }

    // --- Referral Records (Only verified by Admin) ---
    match /referrals/{referralId} {
      allow get: if isValidId(referralId) && isSignedIn() &&
                    (existing().referredUserId == request.auth.uid ||
                     existing().referrerUserId == request.auth.uid ||
                     isAdmin());
      allow list: if isSignedIn() && (
                     existing().referrerUserId == request.auth.uid ||
                     existing().referredUserId == request.auth.uid ||
                     isAdmin()
                   );

      allow create: if isValidId(referralId) && isSignedIn() &&
                       incoming().referredUserId == request.auth.uid &&
                       incoming().status == 'PENDING_VERIFICATION' &&
                       incoming().isVerified == false &&
                       incoming().keys().hasAll(['referrerCode', 'referredUserId', 'referredName', 'status', 'isVerified', 'createdAt']) &&
                       incoming().keys().hasOnly(['referrerUserId', 'referrerCode', 'referredUserId', 'referredName', 'status', 'isVerified', 'createdAt']) &&
                       isValidTimestamp(incoming().createdAt) &&
                       isValidReferralRecord(incoming());

      allow update: if isValidId(referralId) && isAdmin() && isValidReferralRecord(incoming());
      allow delete: if false;
    }
  }
}
